{
  "kind": "collectionType",
  "collectionName": "songs",
  "info": {
    "singularName": "song",
    "pluralName": "songs",
    "displayName": "Song",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "bpm": {
      "type": "integer",
      "default": 0
    },
    "key": {
      "type": "enumeration",
      "enum": [
        "A",
        "Asharp",
        "B",
        "C",
        "Csharp",
        "D",
        "Dsharp",
        "E",
        "F",
        "Fsharp",
        "G",
        "Gsharp"
      ],
      "default": "C"
    },
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "song.song-section"
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::band.band",
      "inversedBy": "songs"
    },
    "timeSignature": {
      "type": "enumeration",
      "enum": [
        "fourFour",
        "threeFour",
        "sixEight",
        "twoFour",
        "fiveFour",
        "twelveEight"
      ],
      "default": "fourFour"
    },
    "slate": {
      "type": "json"
    },
    "song_collab_state": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::song-collab-state.song-collab-state",
      "mappedBy": "song"
    },
    "lastCollabSavedAt": {
      "type": "datetime"
    }
  }
}
